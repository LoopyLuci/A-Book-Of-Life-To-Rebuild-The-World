<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path
        name="shared_apk"
        path="share/" />
    <!--
      Downloaded update packages live in the app's own external files folder
      so the platform installer can read them without granting access to
      anything else on the device.
    -->
    <external-files-path
        name="updates"
        path="Download/" />
</paths>
