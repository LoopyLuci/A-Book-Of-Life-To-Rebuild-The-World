{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abookoflife.org/schemas/field-test.schema.json",
  "title": "Field Test Report",
  "type": "object",
  "required": ["id", "entry_id", "tester", "date", "location", "conditions", "results", "safety_observed"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "verified": { "const": true } },
        "required": ["verified"]
      },
      "then": { "required": ["reviewed_by", "reviewed_at"] }
    }
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ft-[a-z0-9-]{3,64}$" },
    "entry_id": { "type": "string", "pattern": "^pnk:" },
    "tester": { "type": "string", "minLength": 2 },
    "tester_contact": {
      "type": "string",
      "description": "Optional. Reports are public; do not include personal contact information."
    },
    "date": { "type": "string", "format": "date" },
    "location": { "type": "string" },
    "gps": {
      "type": "string",
      "description": "Optional coarse location only. Do not publish precise coordinates that could identify a person or sensitive site."
    },
    "conditions": {
      "type": "object",
      "properties": {
        "weather": { "type": "string" },
        "temperature_c": { "type": "number" },
        "altitude_m": { "type": "number" },
        "materials_substituted": { "type": "string" },
        "tools_available": { "type": "array", "items": { "type": "string" } }
      }
    },
    "procedure_followed": { "type": "string" },
    "deviations": { "type": "string" },
    "results": { "type": "string", "minLength": 10 },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" }
        }
      }
    },
    "failure_modes": { "type": "string" },
    "safety_observed": { "type": "boolean" },
    "safety_notes": { "type": "string" },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Publicly shareable paths only. Obtain consent and remove location metadata before submission."
      }
    },
    "recommendations": { "type": "string" },
    "duration_minutes": { "type": "number" },
    "reviewed_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Public reviewer name, team, or pseudonym; do not include private contact details."
    },
    "reviewed_at": { "type": "string", "format": "date" },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether maintainers reviewed this report for publication; true requires reviewed_by and reviewed_at and does not certify the procedure."
    }
  }
}
