<% content_for :title, page_title(t("about")) %>
<% content_for :description, t("tagline") %>

<h1><%= t("about") %></h1>

<dl class="facts">
  <dt><%= t("version") %></dt>
  <dd><%= @version %></dd>

  <dt><%= t("entries") %></dt>
  <dd><%= @total_entries %></dd>

  <dt><%= t("domains") %></dt>
  <dd><%= @domain_count %></dd>

  <dt><%= t("language") %></dt>
  <dd><%= @languages.map { |code| language_name(code) }.join(", ") %></dd>
</dl>

<section class="section" aria-labelledby="disclaimer-heading">
  <h2 id="disclaimer-heading"><%= t("disclaimer") %></h2>

  <blockquote class="disclaimer-summary">
    <%= markdown(@disclaimer_summary) %>
  </blockquote>

  <div class="disclaimer-full">
    <%= markdown(@disclaimer) %>
  </div>
</section>
